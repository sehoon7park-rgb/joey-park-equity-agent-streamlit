# Joey Park U.S. Equity Investment Agent — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM provider (required for research/critic/decision agents) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Macro data (optional) ---
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html
# If unset, the Macro Agent reports DATA_NOT_AVAILABLE instead of failing.
FRED_API_KEY=

# --- News data (optional) ---
# If unset, the News & Catalyst Agent reports DATA_NOT_AVAILABLE instead of failing.
NEWS_API_KEY=

# --- SEC EDGAR (required for Tier-1 official data; free, no signup) ---
# SEC's fair-access policy requires a real contact identifier in every
# request's User-Agent header. Put your own name/email here.
SEC_EDGAR_CONTACT_EMAIL=your-email@example.com

# --- App config ---
JOEY_PARK_DB_PATH=./joey_park.db
JOEY_PARK_CONFIG_PATH=./joey_park/config/config.yaml
JOEY_PARK_LOG_LEVEL=INFO
